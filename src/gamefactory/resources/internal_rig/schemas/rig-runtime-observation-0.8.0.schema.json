{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rig-runtime-observation-0.8.0",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "reason",
    "method",
    "request_digest",
    "glb_sha256",
    "contract_sha256",
    "harness_sha256",
    "godot_version",
    "pose_bone",
    "observed_bone_transform",
    "vertex_samples",
    "max_affected_displacement",
    "max_unaffected_displacement",
    "affected_vertex_count",
    "unaffected_vertex_count",
    "vertex_count"
  ],
  "properties": {
    "schema_version": {"const": "rig-runtime-observation-0.8.0"},
    "status": {"enum": ["PASS", "FAIL"]},
    "reason": {"type": "string", "minLength": 1},
    "method": {"const": "bake_mesh_from_current_skeleton_pose"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "glb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "harness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "godot_version": {"type": "string", "minLength": 1},
    "pose_bone": {"type": "string", "minLength": 1},
    "observed_bone_transform": {"type": "object"},
    "vertex_samples": {"type": "array", "minItems": 1},
    "max_affected_displacement": {"type": "number"},
    "max_unaffected_displacement": {"type": "number"},
    "affected_vertex_count": {"type": "integer", "minimum": 0},
    "unaffected_vertex_count": {"type": "integer", "minimum": 0},
    "vertex_count": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": true
}
