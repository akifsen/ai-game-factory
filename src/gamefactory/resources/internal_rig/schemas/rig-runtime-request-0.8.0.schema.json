{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rig-runtime-request-0.8.0",
  "type": "object",
  "required": [
    "schema_version",
    "glb_sha256",
    "contract_sha256",
    "harness_sha256",
    "godot_version",
    "pose_bone",
    "rotation_axis",
    "rotation_degrees",
    "affected",
    "unaffected",
    "min_affected_displacement",
    "max_unaffected_displacement",
    "max_affected_displacement",
    "vertex_count",
    "affected_vertex_count",
    "unaffected_vertex_count",
    "region_boundary_tolerance",
    "request_digest"
  ],
  "properties": {
    "schema_version": {"const": "rig-runtime-request-0.8.0"},
    "glb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "harness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "godot_version": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pose_bone": {"type": "string", "minLength": 1},
    "rotation_axis": {"type": "array", "minItems": 3, "maxItems": 3},
    "rotation_degrees": {"type": "number"},
    "affected": {"type": "object"},
    "unaffected": {"type": "object"},
    "min_affected_displacement": {"type": "number"},
    "max_unaffected_displacement": {"type": "number"},
    "max_affected_displacement": {"type": "number"},
    "vertex_count": {"type": "integer", "minimum": 0},
    "affected_vertex_count": {"type": "integer", "minimum": 0},
    "unaffected_vertex_count": {"type": "integer", "minimum": 0},
    "region_boundary_tolerance": {"type": "number", "const": 1e-6}
  },
  "additionalProperties": true
}
