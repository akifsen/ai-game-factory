[node name="VBox" type="VBoxContainer" parent="SessionUI/Root/SessionMargin/SessionScroll/SessionPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="SessionUI/Root/SessionMargin/SessionScroll/SessionPanel/VBox"]
