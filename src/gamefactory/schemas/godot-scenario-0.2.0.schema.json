{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-factory.local/schemas/godot-scenario-0.2.0.schema.json",
  "title": "AI Game Factory Godot Verification Scenario 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "scene", "max_tick", "timeout_seconds", "snapshots", "assertions"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "scenario_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "scene": {"type": "string", "minLength": 7, "maxLength": 512, "pattern": "^res://(?!\\.{1,2}/)(?!/)(?!.*//)(?!.*(?:/|^)\\.{1,2}/)(?!.*[\\\\:\\u0000-\\u001f\\u007f]).+\\.tscn$"},
    "max_tick": {"type": "integer", "minimum": 1, "maximum": 10000},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "import_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120, "default": 30},
    "actions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["tick", "action", "amount"], "properties": {"tick": {"type": "integer", "minimum": 1, "maximum": 10000}, "action": {"const": "apply_damage"}, "amount": {"type": "integer", "minimum": 1, "maximum": 1000000}}},
          {"type": "object", "additionalProperties": false, "required": ["tick", "action"], "properties": {"tick": {"type": "integer", "minimum": 1, "maximum": 10000}, "action": {"const": "defeat_enemy"}}}
        ]
      }
    },
    "snapshots": {"type": "array", "minItems": 2, "maxItems": 256, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 10000}},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tick", "field", "operator", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "tick": {"type": "integer", "minimum": 0, "maximum": 10000},
          "field": {"enum": ["player_hp", "enemies_remaining", "score"]},
          "operator": {"enum": ["equals", "minimum", "maximum"]},
          "expected": {"type": "integer"}
        }
      }
    }
  }
}
