{
  "$defs": {
    "DccConfig": {
      "additionalProperties": false,
      "properties": {
        "blender_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blender Path"
        }
      },
      "title": "DccConfig",
      "type": "object"
    },
    "EngineConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "godot",
          "title": "Type",
          "type": "string"
        },
        "executable_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Path"
        }
      },
      "title": "EngineConfig",
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "paid_operations_require_approval": {
          "default": true,
          "title": "Paid Operations Require Approval",
          "type": "boolean"
        },
        "destructive_operations_require_approval": {
          "default": true,
          "title": "Destructive Operations Require Approval",
          "type": "boolean"
        },
        "require_approval_for_repo_write": {
          "default": false,
          "title": "Require Approval For Repo Write",
          "type": "boolean"
        },
        "require_approval_for_process_execution": {
          "default": false,
          "title": "Require Approval For Process Execution",
          "type": "boolean"
        },
        "max_operation_cost": {
          "default": 50.0,
          "minimum": 0,
          "title": "Max Operation Cost",
          "type": "number"
        },
        "project_budget": {
          "default": 500.0,
          "minimum": 0,
          "title": "Project Budget",
          "type": "number"
        }
      },
      "title": "PolicyConfig",
      "type": "object"
    },
    "ProjectInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/ProjectInfo"
    },
    "engine": {
      "$ref": "#/$defs/EngineConfig"
    },
    "dcc": {
      "$ref": "#/$defs/DccConfig"
    },
    "policies": {
      "$ref": "#/$defs/PolicyConfig"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    },
    "documents": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Documents",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "project"
  ],
  "title": "AI Game Factory project configuration 0.1.0",
  "type": "object",
  "$id": "https://ai-game-factory.local/schemas/project-config-0.1.0.schema.json"
}
